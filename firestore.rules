rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProject(data, docId, userId) {
      return data.id is string &&
        data.id == docId &&
        isValidId(data.id) &&
        data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        data.objectCount is number &&
        data.objects is list &&
        data.objects.size() <= 500 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 64 &&
        data.createdAt is string &&
        data.createdAt.size() <= 64;
    }

    // User-scoped project documents for cloud save & autosave
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId) && isValidId(projectId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(projectId) &&
        isValidProject(incoming(), projectId, userId) &&
        incoming().keys().hasAll(['id', 'userId', 'title', 'objectCount', 'objects', 'updatedAt', 'createdAt']) &&
        incoming().keys().size() == 7;
      allow update: if isOwner(userId) &&
        isValidId(projectId) &&
        isValidProject(incoming(), projectId, userId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'objectCount', 'objects', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(projectId);
    }
  }
}
